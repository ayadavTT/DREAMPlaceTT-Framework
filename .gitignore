# build artifacts
host/build/
**/build_ttnn/
**/__pycache__/
*.pyc
*.pyo
*.so
*.o
*.obj

# results scratch (the curated snapshots in results/sweep_a1_bb3_report/
# and results/sweep_v2_final/ are intentionally tracked)
results/sweep_latest/
results/dbg_*/
results/tmp_*/

# debug dumps
*.bin
!results/**/*.bin  # if any small fixture dumps end up tracked

# editor / OS noise
.vscode/
.idea/
.DS_Store
*.swp
*~

# Python venv (DREAMPlace's dp_env should be a submodule artifact, not committed)
dp_env/
*.egg-info/

# tt-metal/ and DREAMPlace/ are git submodules — see .gitmodules. Do NOT
# add them back to this ignore list; the submodule worktrees are managed
# by git submodule update.

core
DREAMPlace-lowprec/
OpenTimer-integrate-backward-cpp/
dreamplacett/
generated/
ipc_shm/
tt_metal_build.log
tt_server_build.log
.claude/

# in-framework venv used by orchestrators
DREAMPlace/dp_env
DREAMPlace/install
tt-metal/build
